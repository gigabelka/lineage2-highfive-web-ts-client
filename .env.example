# Copy this file to `.env` (git-ignored) and fill in real credentials.
#
# WARNING: these are exposed to the browser bundle via `envPrefix: ["VITE_", "L2_"]`
# in vite.config.ts. Dev only - never run `npm run build-dev` with real credentials.
# The network session is additionally gated on `import.meta.env.DEV` (src/net/config.ts)
# and the TCP bridge plugin is `apply: "serve"`, so a production build carries neither.

L2_LOGIN_IP=192.168.0.33
L2_LOGIN_PORT=2106
# The game port from the login server's ServerList is ignored in favour of this one -
# a LAN L2J-Mobius commonly advertises 127.0.0.1, which is the *browser's* loopback.
L2_GAME_PORT=7777
L2_USERNAME=qwerty
L2_PASSWORD=changeme
L2_SERVER_ID=2
L2_CHAR_SLOT=0
# HighFive. Must be in the server's ServerConfig.PROTOCOL_LIST or ProtocolVersion is rejected.
L2_PROTOCOL=267
# Client-initiated keepalive interval. See src/net/opcodes.ts - on this server the CLIENT
# pings (0xB1) and the server answers (0xD9), which is the reverse of server-protocol.md.
L2_PING_MS=30000
